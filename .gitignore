# SPDX-License-Identifier: Apache-2.0
# AegisGate Scanner — .gitignore
# https://github.com/aegisgate-security/aegisgate-scanner

# Binaries
/aegisgate-scanner
/aegisgate-scanner-*
*.exe
*.dll
*.so
# Exception: ONNX Runtime shared libraries (third-party, MIT-licensed, needed for CGO builds)
!lib/*/libonnxruntime.so
*.dylib

# Build output
/dist/
/build/
/bin/

# Test artifacts
*.out
*.test
*.prof
coverage.html
cover.out

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# OS files
Thumbs.db
desktop.ini

# Docker (local builds, not the Dockerfile)
docker-compose.override.yml

# Config (local overrides)
.aegisgate.local.yml

# Baseline files (generated, not source)
*.baseline.json

# SARIF / JSON / HTML output (generated by scans)
*.sarif
*.scan.json
*.scan.html

# Model files (tracked separately via Git LFS or release artifacts)
# models/*.onnx
# Adversarial test reports (generated by evasion suite)
pkg/detectors/testing/reports/adversarial/
*.pdf

# =============================================================================
# PROPRIETARY IP — NEVER COMMIT
# =============================================================================
# Patent specifications, coverage analysis, and filing guides contain
# novel invention disclosures and strategic IP analysis. These must
# never be published to the public repository.
plans/
docs/provisional-patent-*.md
docs/provisional-patent-filing-guide.md
docs/patent-coverage-analysis.md
